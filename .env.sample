# Copy to .env and fill in. Keep comments on their own lines:
# docker --env-file does not strip trailing comments.

# --- Microsoft Entra app (required) ---
# https://login.microsoftonline.com/<directory (tenant) id>
AUTHORITY=https://login.microsoftonline.com/your-tenant-id
CLIENT_ID=your-client-app-id
CLIENT_SECRET=your-client-app-secret

# --- SMTP login every device/app uses (required) ---
SMTP_AUTH_USER=relay
# Use 16+ characters; devices without STARTTLS send it unencrypted on the LAN.
SMTP_AUTH_PASS=change-me-to-a-long-random-password

# REQUIRED: the sender (From) addresses devices may send as, comma separated.
# Use each device's configured sender address, or a whole domain: scanner@contoso.com,*@contoso.com
# Why: every device shares one login, and the relay sends as whatever sender a device announces.
# Without this list, anything with the login could send as any mailbox (e.g. the CEO's).
# The relay enforces it before contacting Microsoft 365, so it works even if you never scope the
# app in Exchange. Unlisted senders are refused with "550 5.7.1 Sender address not allowed".
# For protection against a leaked CLIENT_SECRET as well, also scope the app to these mailboxes
# in Exchange Online (tools/Setup-RelayTenant.ps1 or docs/tenant-setup.md).
SMTP_ALLOWED_SENDERS=scanner@contoso.com

# --- Dashboard (optional; off unless both are set) ---
# Web dashboard on port 8080: devices, messages, retry queue, live log and a "send test" form.
# Use its own password, not the SMTP one.
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-to-another-long-random-password
# HTTPS with the relay's certificate (self-signed unless you set TLS_CERT_FILE). Set false behind a reverse proxy.
#DASHBOARD_HTTPS=true
#DASHBOARD_PORT=8080
#DASHBOARD_HOST=0.0.0.0

# --- Optional ---
# Listener (defaults shown)
#SMTP_RELAY_HOSTNAME=0.0.0.0
#SMTP_RELAY_PORT=2525

# Where the TLS certificate, retry queue and log file go (default /data in the container)
#DATA_DIR=/data

# Your own certificate for STARTTLS. If unset, a self-signed one is created once in $DATA_DIR/tls.
#TLS_CERT_FILE=/data/tls/cert.pem
#TLS_KEY_FILE=/data/tls/key.pem

# Messages over ~3 MB need the draft + upload path, which needs the Mail.ReadWrite permission.
#LARGE_MESSAGES=false
#MAX_MESSAGE_SIZE=36700160

# Retry queue for mail Microsoft could not take right away
#QUEUE_DIR=/data/queue
#QUEUE_MAX_AGE_HOURS=24

#MIDDLEWARE_DIR=/usr/src/app/middleware

#LOG_LEVEL=INFO
#LOG_FILE_ENABLED=false
#LOG_FILE=/data/logs/smtp_relay.log

# --- tools/send_test.py only ---
#TEST_FROM_ADDRESS=scanner@contoso.com
#TEST_TO_ADDRESS=you@contoso.com
